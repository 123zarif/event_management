# ==============================================================================
# ClubSphere Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development or .env.production for production:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 💻 1. LOCAL DEVELOPMENT CONFIGURATION (Default)
# ------------------------------------------------------------------------------
# Use these settings when developing locally with `npm run dev`:

# PostgreSQL Database (Port 5433 mapped via local docker-compose)
DATABASE_URL="postgresql://clubsphere:clubsphere_secure_password@localhost:5433/clubsphere_db?schema=public"

# Redis Cache & Concurrency Lock
REDIS_URL="redis://localhost:6379"

# NextAuth / Auth.js (HTTP for localhost)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="clubsphere_super_secret_development_key_2026"

# App Public URL (For OpenGraph tags & sitemap generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Club Flagship Slug
NEXT_PUBLIC_DEFAULT_ORG_SLUG="drmc-it-club"

# Local Docker / Caddy Domain (Serves over plain HTTP)
SITE_ADDRESS=":80"


# ------------------------------------------------------------------------------
# 🚀 2. PRODUCTION DEPLOYMENT CONFIGURATION (zarifzuhayer.tech)
# ------------------------------------------------------------------------------
# When deploying to production (VPS / Docker / Cloud), uncomment and set these:

# --- Production Database ---
# If using the internal Docker PostgreSQL container:
# DATABASE_URL="postgresql://clubsphere:your_strong_password@postgres:5432/clubsphere_db?schema=public"
# Or if using an external managed cloud database (Neon, Supabase, Railway, etc.):
# DATABASE_URL="postgresql://user:password@your-db-host.com:5432/clubsphere_db?sslmode=require"

# --- Production Redis ---
# REDIS_URL="redis://redis:6379"

# --- Production Authentication (HTTPS required for secure cookies) ---
# NEXTAUTH_URL="https://zarifzuhayer.tech"
# Generate a secret with: openssl rand -base64 32
# NEXTAUTH_SECRET="replace_with_a_long_random_production_secret"

# --- Production Canonical URL (For dynamic OG images & SEO metadata) ---
# NEXT_PUBLIC_APP_URL="https://zarifzuhayer.tech"

# --- Caddy Automatic HTTPS Domain ---
# SITE_ADDRESS="zarifzuhayer.tech"


# ------------------------------------------------------------------------------
# 🐳 3. OPTIONAL DOCKER COMPOSE PORT & CONTAINER OVERRIDES
# ------------------------------------------------------------------------------
# POSTGRES_USER=clubsphere
# POSTGRES_PASSWORD=clubsphere_secure_password
# POSTGRES_DB=clubsphere_db
# POSTGRES_PORT=5433
# REDIS_PORT=6379
# WEB_PORT=3000
# HTTP_PORT=80
# HTTPS_PORT=443
