# Production Caddyfile for zarifzuhayer.tech
# Automatic HTTPS via Let's Encrypt / ZeroSSL

# Redirect www to apex domain
www.zarifzuhayer.tech {
	redir https://zarifzuhayer.tech{uri} permanent
}

zarifzuhayer.tech {
	# Reverse proxy to Next.js application container
	reverse_proxy web:3000

	# Modern high-performance compression
	encode gzip zstd

	# Production security headers
	header {
		# HTTP Strict Transport Security (HSTS)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# MIME-type sniffing defense
		X-Content-Type-Options "nosniff"
		# Clickjacking defense
		X-Frame-Options "SAMEORIGIN"
		# Strict referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Request body limit for file and image uploads
	request_body {
		max_size 25MB
	}
}
